[Unit]
Description=CloudPBX rolling SIP packet capture (per-leg PCAP source)
After=network.target freeswitch.service

[Service]
Type=simple
User=root
Group=root
# Rolling SIP-only capture. RTP is excluded — only signaling, which is tiny.
# Files rotate every 5 minutes (-G 300), no -W, so they're kept until manually
# deleted. Small files matter: the per-call slice (sngrep) scans whole files, and
# a 200MB hourly file took ~10s to slice vs ~1s for a ~15MB 5-minute file.
#
# The BPF filter is generated by gen-sip-capture-filter.sh into /etc/sip-capture.bpf
# so we only capture TENANT traffic: all authenticated internal/webrtc legs, plus
# external :5060 traffic only to/from our carrier gateways — dropping the open-
# internet scanner flood. ExecStartPre regenerates it from live FS gateways on
# every (re)start, so adding a carrier + restarting picks it up automatically.
EnvironmentFile=/opt/Cloud-PBX/.env
ExecStartPre=/usr/bin/install -d -m 0755 -o root -g root /var/spool/sip
ExecStartPre=/opt/Cloud-PBX/deploy/gen-sip-capture-filter.sh /etc/sip-capture.bpf
ExecStart=/bin/sh -c '/usr/bin/tcpdump -i any -s 0 -n -U -Z root \
  -w /var/spool/sip/sip-%%Y%%m%%d-%%H%%M%%S.pcap -G 300 \
  "$(cat /etc/sip-capture.bpf)"'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sip-capture

[Install]
WantedBy=multi-user.target
