[Unit]
Description=Cloud PBX Celery Worker
After=network.target redis.service postgresql.service
Requires=redis.service

[Service]
Type=forking
User=cloudpbx
Group=cloudpbx
WorkingDirectory=/opt/Cloud-PBX/backend
EnvironmentFile=/opt/Cloud-PBX/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
PIDFile=/var/run/cloudpbx/celery.pid
ExecStart=/opt/Cloud-PBX/backend/venv/bin/celery \
    -A config \
    multi start worker \
    --pidfile=/var/run/cloudpbx/celery.pid \
    --logfile=/var/log/cloudpbx/celery.log \
    --loglevel=INFO \
    --concurrency=4 \
    --queues=default,esl,email
ExecStop=/opt/Cloud-PBX/backend/venv/bin/celery \
    -A config multi stopwait worker \
    --pidfile=/var/run/cloudpbx/celery.pid
ExecReload=/opt/Cloud-PBX/backend/venv/bin/celery \
    -A config multi restart worker \
    --pidfile=/var/run/cloudpbx/celery.pid \
    --logfile=/var/log/cloudpbx/celery.log \
    --loglevel=INFO
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
