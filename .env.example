# Django
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost
CSRF_TRUSTED_ORIGINS=http://your-domain.com
CORS_ALLOWED_ORIGINS=http://your-domain.com

# Database
DB_NAME=ihspbx
DB_USER=ihspbx
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=5432
VOICEMAIL_SQLITE_PATH=/var/lib/freeswitch/db/voicemail_default.db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Security
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# FreeSWITCH ESL
FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=ClueCon
FREESWITCH_TIMEOUT=5

# FreeSWITCH paths
FREESWITCH_CONF_DIR=/etc/freeswitch
FREESWITCH_SOUNDS_DIR=/usr/share/freeswitch/sounds
FREESWITCH_GATEWAY_DIR=/etc/freeswitch/sip_profiles/external
FREESWITCH_RECORDINGS_DIR=/var/lib/freeswitch/recordings
FREESWITCH_VOICEMAIL_DIR=/var/lib/freeswitch/storage/voicemail

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=IHS PBX <noreply@example.com>

# App
FRONTEND_URL=http://your-domain.com
PBX_DEFAULT_DOMAIN=your-domain.com
TIME_ZONE=UTC

# Logging
LOG_FILE=/var/log/ihspbx/app.log

# Media / Static
MEDIA_ROOT=/opt/ihspbx-django/backend/media
STATIC_ROOT=/opt/ihspbx-django/backend/staticfiles
